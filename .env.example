# BugSpotter API base URL — e.g. http://localhost:3000 for local dev,
# https://api.kz.bugspotter.io for SaaS, or your self-hosted deployment.
BUGSPOTTER_BASE_URL=http://localhost:3000

# Project-scoped API key (must start with "bgs_"). Needs reports:read + reports:write
# permissions and at least one project in allowed_projects.
BUGSPOTTER_API_KEY=bgs_replace_me

# Default project UUID used when a tool call omits project_id.
BUGSPOTTER_DEFAULT_PROJECT=

# Where JSONL behavioral logs are written. Defaults to ./logs/.
LOG_DIR=./logs
