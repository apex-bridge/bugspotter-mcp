# bugspotter-mcp deployment env. Copy to .env and edit.

# ─── Standalone mode ─────────────────────────────────────────────────
# The public domain Caddy will obtain a TLS cert for, and the address you'll
# tell agents to connect to. Must already have an A/AAAA record pointing at
# this host before `docker compose up -d`.
MCP_DOMAIN=mcp.kz.bugspotter.io

# Any monitored mailbox — Let's Encrypt sends expiry warnings here.
ACME_EMAIL=info@bugspotter.io

# ─── Upstream BugSpotter ────────────────────────────────────────────
# SaaS / external instance:
BUGSPOTTER_BASE_URL=https://api.kz.bugspotter.io
# Sidecar mode (when on the same compose network as your BugSpotter backend):
# BUGSPOTTER_BASE_URL=http://bugspotter:3000

# ─── Optional ───────────────────────────────────────────────────────
# Sidecar mode only: name of the existing BugSpotter compose network.
# BUGSPOTTER_NETWORK=bugspotter

# Force the MCP server to emit one-line JSON logs to stdout in addition to
# the JSONL behavioral log. `text` (default) is human-readable; `json` is
# what log shippers want. Either way the JSONL behavioral log is unaffected.
MCP_LOG_FORMAT=json
