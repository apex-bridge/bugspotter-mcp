{
  "_comment": "Add to .cursor/mcp.json in your Cursor project (or ~/.cursor/mcp.json for user-wide). Replace placeholders.",
  "mcpServers": {
    "bugspotter": {
      "command": "node",
      "args": ["/absolute/path/to/bugspotter-mcp/dist/server.js"],
      "env": {
        "BUGSPOTTER_BASE_URL": "http://localhost:3000",
        "BUGSPOTTER_API_KEY": "bgs_replace_me",
        "BUGSPOTTER_DEFAULT_PROJECT": "00000000-0000-0000-0000-000000000000",
        "LOG_DIR": "/absolute/path/to/bugspotter-mcp/logs"
      }
    }
  }
}
